{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Telegram Kursat",
      "type": "shell",
      "command": "node index.mjs",
      "options": {
        "cwd": "${workspaceFolder}/tools/telegram-kursat"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "telegram-kursat",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "köprüsü açık|zaten açık"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
